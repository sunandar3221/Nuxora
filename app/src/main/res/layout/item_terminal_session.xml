<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sessionContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_terminal_key"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivSessionStatus"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_terminal"
        app:tint="#38BDF8" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp">

        <TextView
            android:id="@+id/tvSessionName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sesi 1: Ubuntu"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvSessionMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRoot • Sesi Aktif"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseSessionItem"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="Tutup Sesi"
        app:icon="@drawable/ic_close"
        app:iconSize="16dp"
        app:iconTint="#F87171" />
</LinearLayout>
