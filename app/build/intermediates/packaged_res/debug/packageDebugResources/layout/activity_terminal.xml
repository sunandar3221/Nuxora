<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0E14">

    <!-- Terminal Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#161B22"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_terminal"
            app:tint="#38BDF8" />

        <TextView
            android:id="@+id/tvTerminalTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Linux Terminal"
            android:textColor="#F8FAFC"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:layout_marginStart="8dp"
            android:singleLine="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleKeyboard"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Keyboard"
            app:icon="@drawable/ic_keyboard"
            app:iconTint="#94A3B8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearTerminal"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Reset"
            app:icon="@drawable/ic_delete"
            app:iconTint="#94A3B8" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseTerminal"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Close"
            app:icon="@drawable/ic_stop"
            app:iconTint="#F87171" />
    </LinearLayout>

    <!-- Termux-style Terminal Emulator Screen -->
    <com.termux.view.TerminalView
        android:id="@+id/terminalView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- Termux-style Extra Key Toolbar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="#161B22"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <Button
                android:id="@+id/keyEsc"
                android:layout_width="52dp"
                android:layout_height="34dp"
                android:text="ESC"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/keyTab"
                android:layout_width="52dp"
                android:layout_height="34dp"
                android:text="TAB"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/keyCtrl"
                android:layout_width="54dp"
                android:layout_height="34dp"
                android:text="CTRL"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/keyAlt"
                android:layout_width="52dp"
                android:layout_height="34dp"
                android:text="ALT"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/keyUp"
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:text="▲"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/keyDown"
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:text="▼"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/keyLeft"
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:text="◀"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/keyRight"
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:text="▶"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/keyCtrlC"
                android:layout_width="62dp"
                android:layout_height="34dp"
                android:text="Ctrl+C"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/keyCtrlD"
                android:layout_width="62dp"
                android:layout_height="34dp"
                android:text="Ctrl+D"
                android:textSize="11sp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/keySlash"
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:text="/"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/keyMinus"
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:text="-"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/keyPipe"
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:text="|"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/keyTilde"
                android:layout_width="44dp"
                android:layout_height="34dp"
                android:text="~"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginEnd="4dp" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
